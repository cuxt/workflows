# 复制成 .env 后填写；docker compose 会自动读取同目录的 .env。
#
# 镜像：本仓库 CI 打好的那份。把 <owner> 换成 GitHub 用户名/组织名（GHCR 全小写）。
# latest 跟着上游最新 release 走；想钉版本就写 :v2.2.0。
AGENTS_ANYWHERE_IMAGE=ghcr.io/<owner>/agents-anywhere:latest

# 两个密码都用 hex（只含 0-9a-f）：DB URL 是拼字符串的，密码里有 @ : / 会把它拆坏。
# 生成：openssl rand -hex 32
POSTGRES_PASSWORD=
AGENT_SERVER_SECRET=

# Web 控制台监听端口（只绑 127.0.0.1，生产放 HTTPS 反代后面）
AGENTS_ANYWHERE_WEB_PORT=5174

# 反向代理后面部署时填真实对外地址，OAuth 回调要用
AGENT_SERVER_PUBLIC_ORIGIN=
